# Opcional: habilita el contexto macro de FRED.
FRED_API_KEY=

# Opcional: sentimiento social. El bot sigue funcionando sin esta clave.
LUNARCRUSH_API_KEY=

# Opcional: alertas de Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opcional: CoinGecko Demo API (mejora límites de uso).
COINGECKO_API_KEY=

# Ruta/configuración avanzada.
BOT_CONFIG=backend/config.yaml
BOT_LOG_LEVEL=INFO

# auto: Binance local, Kraken en GitHub Actions, con fallback mutuo.
# Valores válidos: auto, binance, kraken.
MARKET_DATA_PROVIDER=auto

# Tasas efectivas de tu nivel de Binance Futures (decimales, no porcentajes).
# Ejemplo 0.0005 = 0.05 %. Si se omiten, se usa backend/config.yaml.
BINANCE_MAKER_FEE_RATE=
BINANCE_TAKER_FEE_RATE=
BINANCE_BNB_FEE_DISCOUNT_PCT=

# Mantener en shadow hasta que validation_v2.status sea validated.
BOT_STRATEGY_MODE=shadow
